# Hetzner Cloud API Token
# In Hetzner Cloud unter Projekt -> Security -> API Tokens erzeugen
HCLOUD_TOKEN=dein_api_token_hier

# Standardmäßig wird CX43 überwacht
HETZNER_SERVER_TYPE=cx43

# Leer lassen = alle von Hetzner für diesen Typ unterstützten Locations prüfen
# Beispiel: fsn1,nbg1,hel1
HETZNER_LOCATIONS=

# Polling alle 30 Sekunden
CHECK_INTERVAL_SECONDS=30
REQUEST_TIMEOUT_SECONDS=15

# true = Script beendet sich nach erfolgreicher E-Mail
# false = Script läuft weiter
STOP_AFTER_ALERT=false

# Optional: eigener Pfad für die Statusdatei
STATE_FILE=state.json

# SMTP / E-Mail
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=dein_smtp_benutzer
SMTP_PASSWORD=dein_smtp_passwort

EMAIL_FROM=deine-adresse@example.com
EMAIL_TO=deine-adresse@example.com

SMTP_TIMEOUT_SECONDS=20
